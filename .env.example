# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Secret the AI service sends in X-YooWifi-Service-Key to authenticate itself
SERVICE_API_KEY=changeme-ai-service-key

# Absolute or relative path to the tenant registry JSON file
REGISTRY_PATH=./src/registry/tenants.json

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Per-tenant secrets (referenced by *Ref names in tenants.json) ─────────────
# Portal "tune" shared secret  (tenants.json → auth.sharedSecretRef = "SECRET_PORTAL_TUNE")
SECRET_PORTAL_TUNE=changeme-portal-tune-secret

# Legacy app AES-256-CBC key — must be exactly 32 bytes (256 bits)
# (tenants.json → auth.encryption.keyRef = "AESKEY_LEGACY_APP")
AESKEY_LEGACY_APP=changeme-32-byte-aes-key-here!!

# Add one entry per *Ref value that appears in tenants.json.
# The server validates all refs are present at startup and exits with a clear
# error listing any that are missing.
